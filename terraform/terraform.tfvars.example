# Copy this file to terraform.tfvars and put in your own values.
# terraform.tfvars is ignored by git.

location            = "southafricanorth"
project_name        = "findr"
environment         = "dev"
vnet_address_space  = ["10.0.0.0/16"]
subnet_cidr         = "10.0.1.0/24"
my_ip_cidr          = "203.0.113.10/32"
app_port            = 80
vm_size             = "Standard_B2ats_v2"
admin_username      = "azureuser"
ssh_public_key_path = "~/.ssh/findr.pub"
