# Copy this file to terraform.tfvars and put in your own values.
# terraform.tfvars is ignored by git.

location            = "southafricanorth"
project_name        = "findr"
environment         = "dev"
vnet_address_space  = ["10.0.0.0/16"]
public_subnet_cidr  = "10.0.1.0/24"
private_subnet_cidr = "10.0.2.0/24"
allowed_ssh_cidrs   = ["203.0.113.10/32"]
app_port            = 80
health_probe_path   = "/api/health"
bastion_vm_size     = "Standard_B2ats_v2"
app_vm_size         = "Standard_B2ats_v2"
admin_username      = "azureuser"
ssh_public_key_path = "~/.ssh/findr.pub"

# GitHub Actions service principal (OIDC). An ID, not a secret
cd_principal_id = "3973b07a-5d4c-4a25-bd96-113e8f3a4df0"
