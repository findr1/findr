# Managed by Ansible (roles/app_deploy). Do not edit on the server.
name: findr
services:
  app:
    image: "{{ acr_login_server }}/{{ findr_image_name }}:{{ findr_image_tag }}"
    env_file: .env
    environment:
      PORT: "3000"
      NODE_ENV: production
    ports:
      - "80:3000"     # Load Balancer sends visitors here
      - "9464:9464"   # /metrics, only the monitoring VM may reach it (NSG)
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://localhost:3000/api/health"]
      interval: 15s
      timeout: 5s
      retries: 3
      start_period: 20s
    restart: unless-stopped
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
